# Copy to .env.local. Placeholders work for /demo only; use YOUR dev project for login.
# Скопируйте в .env.local. Заглушки подходят только для /demo; для входа нужен СВОЙ dev-проект.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional server-only keep-alive credentials. Leave empty for demo/UI development.
# Необязательные серверные credentials для keep-alive. Для демо/интерфейса оставьте пустыми.
# Never put service-role/secret keys in NEXT_PUBLIC_* variables.
# Никогда не помещайте service-role/secret keys в переменные NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
